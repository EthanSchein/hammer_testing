# Airflow / Postgres secrets -- TEMPLATE.
#
# The committed airflow.cfg has these fields blank; the launcher
# (scripts/airflow-standalone-ldap.py) loads the real values from a
# GPG-encrypted copy of THIS file at startup.
#
# Easiest path: don't fill this in by hand -- run
#     ./scripts/sledge-secrets-create.sh
# which prompts you for the values and encrypts them into this checkout.
#
# Manual path: copy your values in below, then encrypt + shred the plaintext:
#     mkdir -p .sledgehammer
#     gpg --symmetric --cipher-algo AES256 \
#         -o .sledgehammer/airflow-secrets.env.gpg airflow-secrets.env
#     shred -u airflow-secrets.env
#
# These KEY=VALUE lines are injected as env vars, which Airflow reads in
# preference to airflow.cfg. NEVER commit the filled-in or decrypted form.

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<user>:<password>@localhost:5544/airflow_<you>
AIRFLOW__CORE__FERNET_KEY=<your current fernet_key -- must stay constant>
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=<your internal_api_secret_key>
AIRFLOW__API__SECRET_KEY=<your secret_key>
AIRFLOW__API_AUTH__JWT_SECRET=<your jwt_secret>

# pd_store (the PD cache) reads this for the sledgehammer_studio DB:
HAMMER_PG_PASSWORD=<your postgres password>
